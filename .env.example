# توکن ربات تلگرام — از BotFather بگیرید
TELEGRAM_BOT_TOKEN=

# شناسه چتی که پیام‌ها به آن می‌رود.
# ساده‌ترین راه پیدا کردنش: به ربات خودتان یک پیام بدهید، بعد باز کنید
# https://api.telegram.org/bot<TOKEN>/getUpdates  و عدد result[0].message.chat.id را بردارید.
TELEGRAM_CHAT_ID=

# هر چند ساعت جستجوهای ذخیره‌شده خودکار اجرا شوند. خالی یا 0 یعنی خاموش
# (آن وقت خودتان python -m divar_demo.notify را اجرا می‌کنید).
NOTIFY_INTERVAL_HOURS=

# فقط آگهی‌هایی که رهن معادلشان دست‌کم این‌قدر درصد کم شده پیام شوند
NOTIFY_PRICE_DROP_PCT=5

# حداکثر چند آگهی در هر بار اطلاع‌رسانی
NOTIFY_MAX_ITEMS=10
